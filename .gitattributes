# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.dart text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.proto text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Shell scripts must be executable
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mbtiles binary
*.wasm binary
*.zip binary
*.tar.gz binary
