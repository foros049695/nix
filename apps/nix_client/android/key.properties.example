# Template de configuração de assinatura de Release para Projeto Nix
# Copie este arquivo para 'key.properties' e preencha com as credenciais da sua Keystore protegida.
# NUNCA comite o arquivo 'key.properties' ou o arquivo '*.jks' no controle de versão.

storePassword=
keyPassword=
keyAlias=nix-release-key
storeFile=release-keystore.jks
